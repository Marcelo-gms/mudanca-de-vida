<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#22050a">
  <title>Tigrinho da Sorte | Caça-Níquel</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bungee&family=Orbitron:wght@600;800&family=Montserrat:wght@500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="game-body" data-balance="<%= wallet.balanceCents %>">
  <div class="game-container">
    <!-- Barra superior: carteira e utilidades -->
    <nav class="topbar" aria-label="Conta">
      <div class="topbar-group">
        <button class="btn-icon" id="openHistoryBtn" title="Histórico e auditoria" aria-label="Histórico e auditoria">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v4l3 2M3.05 11a9 9 0 1 1 .5 4M3 4v7h7"/></svg>
        </button>
        <% if (user && user.role === 'admin') { %>
          <a href="/admin" class="btn-icon" title="Painel de administração" aria-label="Painel de administração">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>
          </a>
        <% } %>
      </div>
      <div class="topbar-group">
        <button class="btn-deposit" id="openDepositBtn">+ Depositar</button>
        <button class="btn-withdraw" id="openWithdrawBtn">Sacar</button>
        <a href="/logout" class="btn-icon" title="Sair" aria-label="Sair">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
        </a>
      </div>
    </nav>

    <main class="machine" id="machine">
      <div class="cabinet">
        <!-- Letreiro com lâmpadas -->
        <header class="topper">
          <span class="bulbs" aria-hidden="true"></span>
          <h1 class="marquee-title">
            <span class="mt-main">Tigrinho</span>
            <span class="mt-sub">★ da Sorte ★</span>
          </h1>
          <span class="bulbs bulbs-rev" aria-hidden="true"></span>
        </header>

        <!-- Tabela de pagamentos -->
        <ul class="paytable" aria-label="Tabela de pagamentos">
          <li><canvas data-sym="TIGRE" aria-label="Tigre"></canvas><b>50x</b></li>
          <li><canvas data-sym="MOEDA" aria-label="Moedas"></canvas><b>10x</b></li>
          <li><canvas data-sym="BARRA" aria-label="Barras de ouro"></canvas><b>5x</b></li>
          <li><canvas data-sym="LARANJA" aria-label="Laranja"></canvas><b>2x</b></li>
        </ul>
        <p class="paytable-note">Paga com <b>3 iguais na faixa dourada</b> · Tigre é coringa</p>

        <!-- Janela dos rolos (ocupa o espaço que sobrar na tela) -->
        <div class="reel-stage">
        <div class="reel-bay">
          <span class="line-marker" aria-hidden="true"></span>
          <div class="reel-window">
            <canvas id="slotCanvas" role="img" aria-label="Rolos do caça-níquel"></canvas>
            <div class="glass" aria-hidden="true"></div>
            <div class="win-banner" id="winBanner">
              <span class="win-text" id="winText">Você ganhou!</span>
              <strong class="win-amount" id="winAmount">R$ 0,00</strong>
            </div>
            <div class="tiger-bonus-alert" id="tigerBonusAlert">Bônus Tigre da Sorte · +5x</div>
          </div>
          <span class="line-marker" aria-hidden="true"></span>
        </div>
        </div>

        <!-- Displays LED -->
        <div class="led-panel">
          <div class="led">
            <span class="led-label">Crédito</span>
            <span class="led-value" id="balanceDisplay">R$ <%= wallet.balanceFormatted %></span>
          </div>
          <div class="led">
            <span class="led-label">Aposta</span>
            <span class="led-value" id="currentBetDisplay">R$ 1,00</span>
          </div>
          <div class="led led-win">
            <span class="led-label">Ganho</span>
            <span class="led-value" id="lastWinDisplay">R$ 0,00</span>
          </div>
        </div>

        <!-- Painel de botões -->
        <section class="deck" aria-label="Controles">
          <div class="bet-row">
            <button class="bet-step-btn" id="betMinusBtn" aria-label="Diminuir aposta">−</button>
            <div class="chips">
              <button class="preset-btn" data-bet="50">0,50</button>
              <button class="preset-btn active" data-bet="100">1</button>
              <button class="preset-btn" data-bet="200">2</button>
              <button class="preset-btn" data-bet="500">5</button>
              <button class="preset-btn" data-bet="1000">10</button>
            </div>
            <button class="bet-step-btn" id="betPlusBtn" aria-label="Aumentar aposta">+</button>
          </div>

          <div class="action-row">
            <button class="deck-btn turbo-toggle" id="turboToggleBtn" aria-pressed="false">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
              <span>Turbo</span>
            </button>
            <button class="spin-btn" id="spinBtn" title="Girar (Espaço)">
              <span class="spin-text">Girar</span>
            </button>
            <button class="deck-btn" id="toggleAudioBtn" aria-pressed="true" aria-label="Som">
              <svg class="ico-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4zM15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/></svg>
              <svg class="ico-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4zM22 9l-6 6M16 9l6 6"/></svg>
              <span>Som</span>
            </button>
          </div>
        </section>

        <div class="coin-tray" id="coinTray" aria-hidden="true"></div>
      </div>

      <!-- Alavanca -->
      <button class="lever" id="lever" aria-label="Puxar a alavanca para girar">
        <span class="lever-base"></span>
        <span class="lever-arm"></span>
        <span class="lever-knob"></span>
      </button>
    </main>
  </div>

  <!-- Celebração de vitórias grandes -->
  <div class="big-win" id="bigWin" aria-hidden="true">
    <div class="big-win-rays"></div>
    <div class="big-win-content">
      <div class="big-win-title" id="bigWinTitle">Grande vitória!</div>
      <div class="big-win-amount" id="bigWinAmount">R$ 0,00</div>
      <div class="big-win-hint">toque para continuar</div>
    </div>
  </div>
  <canvas class="fx-canvas" id="fxCanvas" aria-hidden="true"></canvas>
  <div class="toast-stack" id="toastStack" role="status" aria-live="polite"></div>
  <div class="sr-only" id="srStatus" aria-live="polite"></div>

  <!-- Modal Depósito Pix (Pay-in) -->
  <div class="modal-overlay" id="depositModal">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="depositTitle">
      <div class="modal-header">
        <h3 id="depositTitle">Depósito via Pix</h3>
        <button class="modal-close" data-close="depositModal" aria-label="Fechar">✕</button>
      </div>
      <div class="modal-body">
        <p class="modal-desc">Deposite via Pix para crédito imediato na sua conta.</p>

        <div class="deposit-form" id="depositFormStep">
          <label for="customDepositInput">Selecione ou digite o valor (R$):</label>
          <div class="deposit-presets">
            <button class="dep-preset-btn" data-amount="10">R$ 10</button>
            <button class="dep-preset-btn" data-amount="20">R$ 20</button>
            <button class="dep-preset-btn active" data-amount="50">R$ 50</button>
            <button class="dep-preset-btn" data-amount="100">R$ 100</button>
          </div>
          <div class="form-group mt-2">
            <input type="number" id="customDepositInput" value="50" min="5" max="10000" step="1" inputmode="numeric">
          </div>
          <button class="btn-primary btn-block mt-3" id="generatePixBtn">GERAR PIX COPIA E COLA</button>
        </div>

        <!-- Passo do QR Code gerado -->
        <div class="pix-result" id="pixResultStep" style="display: none;">
          <div class="qrcode-wrapper">
            <img id="pixQrCodeImg" src="" alt="QR Code Pix" />
          </div>
          <div class="pix-copia-cola-box">
            <input type="text" id="pixCodeInput" readonly aria-label="Código Pix copia e cola" />
            <button class="btn-secondary" id="copyPixBtn">COPIAR CHAVE PIX</button>
          </div>
          <div class="pix-status-notice">
            <span class="spinner-dot"></span> Aguardando confirmação do pagamento...
          </div>
          <% if (isMockEnabled) { %>
            <div class="dev-mock-box">
              <span class="dev-badge">MODO TESTE</span>
              <button class="btn-mock-pay" id="simularPagamentoBtn">Simular Pagamento Instantâneo (Dev)</button>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Saque Pix (Pay-out) -->
  <div class="modal-overlay" id="withdrawModal">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="withdrawTitle">
      <div class="modal-header">
        <h3 id="withdrawTitle">Saque via Pix</h3>
        <button class="modal-close" data-close="withdrawModal" aria-label="Fechar">✕</button>
      </div>
      <div class="modal-body">
        <div class="rollover-tracker">
          <div class="rollover-head">
            <span>Progresso do Rollover (1x):</span>
            <span id="rolloverStatusText"><%= wallet.rollover.progressPercent %>%</span>
          </div>
          <div class="progress-bar">
            <div class="progress-fill" id="rolloverProgressFill" style="width: <%= wallet.rollover.progressPercent %>%;"></div>
          </div>
          <small class="rollover-hint" id="rolloverHint">
            <% if (wallet.rollover.isMet) { %>
              ✅ Rollover cumprido! Saque 100% liberado.
            <% } else { %>
              ⚠️ Faltam apostar R$ <%= (wallet.rollover.remainingCents / 100).toFixed(2) %> para liberar o saque.
            <% } %>
          </small>
        </div>

        <div class="form-group mt-3">
          <label for="withdrawPixKey">Chave Pix (CPF Casado Obrigatório):</label>
          <input type="text" id="withdrawPixKey" value="<%= user.document %>" readonly class="input-locked" />
          <small class="field-hint">🔒 Por regras de segurança estrita, o saque é enviado exclusivamente para o CPF do titular cadastrado.</small>
        </div>

        <div class="form-group mt-2">
          <label for="withdrawAmountInput">Valor do Saque (R$):</label>
          <input type="number" id="withdrawAmountInput" min="10" max="<%= (wallet.balanceCents / 100).toFixed(0) %>" value="10" step="1" inputmode="numeric">
          <small class="field-hint">Saldo disponível: R$ <span id="withdrawAvailBalance"><%= wallet.balanceFormatted %></span></small>
        </div>

        <div id="withdrawErrorMsg" class="alert-error" style="display: none;"></div>

        <button class="btn-primary btn-block mt-3" id="confirmWithdrawBtn" <%= !wallet.rollover.isMet ? 'disabled' : '' %>>
          SOLICITAR SAQUE
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Histórico & Provably Fair -->
  <div class="modal-overlay" id="historyModal">
    <div class="modal-card modal-lg" role="dialog" aria-modal="true" aria-labelledby="historyTitle">
      <div class="modal-header">
        <h3 id="historyTitle">Histórico & Auditoria Provably Fair</h3>
        <button class="modal-close" data-close="historyModal" aria-label="Fechar">✕</button>
      </div>
      <div class="modal-body">
        <p class="modal-desc">Todas as rodadas são geradas com CSPRNG seguro e assinadas com Hash SHA-256 auditável.</p>
        <div class="table-responsive">
          <table class="history-table">
            <thead>
              <tr>
                <th>Data</th>
                <th>Aposta</th>
                <th>Ganho</th>
                <th>Mult.</th>
                <th>Hash Provably Fair (SHA-256)</th>
              </tr>
            </thead>
            <tbody id="historyTableBody">
              <tr><td colspan="5" style="text-align:center;">Carregando histórico...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/audio.js"></script>
  <script src="/js/game/symbols.js"></script>
  <script src="/js/game/slotCanvas.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
