<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tigrinho Admin | PushinPay e Webhooks Pix</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="admin-body">
  <div class="admin-wrapper">
    <%- include('header') %>

    <main class="admin-content">
      <div class="page-title-row">
        <div>
          <h2>Integração Gateway PushinPay & Webhooks Pix</h2>
          <p>Configure o seu Token Bearer da PushinPay (Produção ou Sandbox), teste a conectividade e gerencie o webhook público.</p>
        </div>
        <span class="<%= pushinpayConfig.isMock ? 'badge-warning' : 'badge-success' %> badge-lg">
          <%= pushinpayConfig.isMock ? '🧪 Modo Mock Ativo' : '⚡ Modo Real Ativo' %>
        </span>
      </div>

      <div class="admin-grid-2">
        <!-- Configuração PushinPay -->
        <div class="admin-panel-card">
          <div class="panel-card-head">
            <h3>🔑 Credenciais da API PushinPay</h3>
          </div>

          <form id="pushinpayForm" class="mt-3">
            <div class="form-group">
              <label for="pushinpayMockMode">Modo de Operação:</label>
              <select id="pushinpayMockMode" class="admin-input">
                <option value="true" <%= pushinpayConfig.isMock ? 'selected' : '' %>>🧪 Modo Mock (Simulação Local sem Token)</option>
                <option value="false" <%= !pushinpayConfig.isMock ? 'selected' : '' %>>⚡ Modo Real (PushinPay Produção / Sandbox)</option>
              </select>
              <small class="field-hint">No modo real as requisições Pix são processadas diretamente pela PushinPay.</small>
            </div>

            <div class="form-group">
              <label for="pushinpayToken">PUSHINPAY_TOKEN <span class="text-muted">(Bearer Token da conta)</span>:</label>
              <input
                type="password"
                id="pushinpayToken"
                value="<%= pushinpayConfig.token %>"
                placeholder="Cole aqui seu token Bearer da PushinPay"
                class="admin-input"
                autocomplete="off"
              />
              <small class="field-hint">Obtenha no painel da PushinPay em <em>Configurações > Tokens de API</em>.</small>
            </div>

            <div class="form-group">
              <label for="pushinpayUrlBase">URL Base da API:</label>
              <select id="pushinpayUrlBaseSelect" class="admin-input mb-1" onchange="document.getElementById('pushinpayUrlBase').value = this.value">
                <option value="https://api.pushinpay.com.br/api" <%= pushinpayConfig.urlBase.includes('sandbox') ? '' : 'selected' %>>Produção: https://api.pushinpay.com.br/api</option>
                <option value="https://api-sandbox.pushinpay.com.br/api" <%= pushinpayConfig.urlBase.includes('sandbox') ? 'selected' : '' %>>Sandbox: https://api-sandbox.pushinpay.com.br/api</option>
              </select>
              <input
                type="text"
                id="pushinpayUrlBase"
                value="<%= pushinpayConfig.urlBase %>"
                placeholder="https://api.pushinpay.com.br/api"
                class="admin-input"
              />
            </div>

            <div class="form-group">
              <label for="publicWebhookUrl">URL Pública do Webhook:</label>
              <input
                type="text"
                id="publicWebhookUrl"
                value="<%= pushinpayConfig.publicWebhookUrl %>"
                placeholder="Ex: https://seu-dominio.loca.lt/api/webhooks/pushinpay"
                class="admin-input"
              />
              <small class="field-hint">Cadastre esta URL no painel da PushinPay para receber notificações automáticas de pagamento.</small>
            </div>

            <div class="action-btn-row mt-4">
              <button type="button" class="btn-secondary" id="btnTestPushinpay">
                🔌 Testar Conexão (Ping)
              </button>
              <button type="submit" class="btn-primary">
                💾 Salvar Configurações
              </button>
            </div>
          </form>

          <!-- Status do Teste -->
          <div id="testConnResult" class="mt-3" style="display: none;"></div>
        </div>

        <!-- Instruções de Túnel e Webhook -->
        <div class="admin-panel-card">
          <div class="panel-card-head">
            <h3>🌐 Túnel Local para Recebimento de Webhooks</h3>
          </div>
          <p class="modal-desc">Para testar cobranças reais Pix em ambiente local, inicie o túnel para que a PushinPay consiga notificar o seu servidor:</p>

          <div class="tunnel-box">
            <h4>Iniciando o Túnel (Automático)</h4>
            <p>Execute no terminal do projeto:</p>
            <code>npm run tunnel</code>
            <p class="mt-2 text-muted">A URL gerada (ex: <code>https://xxxxx.loca.lt/api/webhooks/pushinpay</code>) será sincronizada automaticamente.</p>
          </div>

          <div class="tunnel-box mt-3">
            <h4>Formato da Rota de Webhook:</h4>
            <code>POST /api/webhooks/pushinpay</code>
            <small class="text-muted mt-1" style="display:block;">
              A PushinPay envia <code>{ "id": "...", "status": "paid", "value": 1000 }</code>. O sistema credita o saldo atomicamente com trava de idempotência.
            </small>
          </div>

          <!-- Histórico de Depósitos Recebidos -->
          <div class="mt-4">
            <h4>Últimos Depósitos Registrados:</h4>
            <div class="table-responsive mt-2">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Data</th>
                    <th>Valor</th>
                    <th>Status</th>
                    <th>ID PushinPay</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (recentWebhooks.length > 0) { %>
                    <% recentWebhooks.forEach(w => { %>
                      <tr>
                        <td><%= new Date(w.created_at).toLocaleTimeString('pt-BR') %></td>
                        <td>R$ <%= (w.amount_cents / 100).toFixed(2) %></td>
                        <td>
                          <span class="<%= w.status === 'COMPLETED' ? 'badge-success' : 'badge-warning' %>">
                            <%= w.status %>
                          </span>
                        </td>
                        <td><code><%= w.external_reference || w.id.substring(0, 8) + '...' %></code></td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td colspan="4" style="text-align: center;">Nenhum depósito recebido ainda.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    // Salvar Configurações
    document.getElementById('pushinpayForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        isMock: document.getElementById('pushinpayMockMode').value === 'true',
        token: document.getElementById('pushinpayToken').value,
        urlBase: document.getElementById('pushinpayUrlBase').value,
        publicWebhookUrl: document.getElementById('publicWebhookUrl').value
      };

      try {
        const res = await fetch('/admin/api/pushinpay/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          alert('✅ Configurações da PushinPay salvas com sucesso!');
          location.reload();
        } else {
          alert(data.error);
        }
      } catch (err) {
        alert('Erro ao salvar: ' + err.message);
      }
    });

    // Testar Conexão
    document.getElementById('btnTestPushinpay').addEventListener('click', async () => {
      const btn = document.getElementById('btnTestPushinpay');
      const resultBox = document.getElementById('testConnResult');
      btn.disabled = true;
      btn.textContent = 'Testando...';
      resultBox.style.display = 'block';
      resultBox.innerHTML = '<span class="text-muted">Enviando requisição de teste para PushinPay...</span>';

      try {
        const res = await fetch('/admin/api/pushinpay/test', { method: 'POST' });
        const data = await res.json();

        if (data.success) {
          resultBox.innerHTML = `
            <div class="alert-success">
              ✅ <strong>${data.mode}</strong>: ${data.message}
            </div>
          `;
        } else {
          resultBox.innerHTML = `
            <div class="alert-error">
              ❌ Falha no teste: ${data.message}
            </div>
          `;
        }
      } catch (err) {
        resultBox.innerHTML = `<div class="alert-error">Erro: ${err.message}</div>`;
      } finally {
        btn.disabled = false;
        btn.textContent = '🔌 Testar Conexão (Ping)';
      }
    });
  </script>
</body>
</html>

