PORT=3000
NODE_ENV=development
# Em produção use um segredo longo e aleatório (ex: openssl rand -hex 32)
SESSION_SECRET=troque_por_um_segredo_forte

# ===== Gateway de Pagamento Asaas =====
# API Key da conta (Integrações > API). Vazio = modo mock automático.
ASAAS_API_KEY=
# Produção: https://api.asaas.com/v3 | Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_URL_BASE=https://api.asaas.com/v3
# Token definido no cadastro do webhook (enviado no header asaas-access-token).
# OBRIGATÓRIO em produção.
ASAAS_WEBHOOK_TOKEN=
# true força simulação local sem chamadas reais ao Asaas
ENABLE_ASAAS_MOCK=true

# ===== Conta de administrador =====
# Criada no boot (scripts/initDb.js) se ainda não existir. Se o e-mail já tiver
# conta (ex.: criada em /register), ela é promovida a admin.
# Em produção: senha com 12+ caracteres; as contas demo NÃO são criadas.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
# CPF do admin (só dígitos). Opcional; necessário apenas se o admin for sacar.
ADMIN_DOCUMENT=
# true = reaplica ADMIN_PASSWORD numa conta existente no próximo boot.
# Use para trocar/recuperar a senha e depois remova.
ADMIN_RESET_PASSWORD=false

ROLLOVER_FACTOR=1.0
DB_FILE=data/tigrinho.sqlite
