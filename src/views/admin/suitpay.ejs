<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0e0507">
  <title>Tigrinho Admin | SuitPay e webhooks</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bungee&family=Orbitron:wght@600;800&family=Montserrat:wght@500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <div class="admin-wrapper">
    <%- include('header') %>

    <main class="admin-content">
      <header class="page-head">
        <div>
          <p class="page-kicker">Pagamentos</p>
          <h1>Gateway SuitPay e webhook</h1>
          <p class="page-desc">Configure as chaves da API (sandbox ou produção), teste a conexão e exponha o webhook público para receber os Pix.</p>
        </div>
        <span class="<%= suitpayConfig.isMock ? 'badge-warning' : 'badge-success' %> badge-lg"><%= suitpayConfig.isMock ? 'Modo mock ativo' : 'Modo real ativo' %></span>
      </header>

      <div class="admin-grid-2">
        <section class="admin-panel-card">
          <div class="panel-card-head">
            <h3><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 2l-2 2m-7.6 7.6a5.5 5.5 0 1 1-7.78 7.78 5.5 5.5 0 0 1 7.78-7.78zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>Credenciais e modo</h3>
          </div>

          <form id="suitpayForm">
            <div class="form-group">
              <label for="suitpayMockMode">Modo de operação</label>
              <select id="suitpayMockMode" class="admin-input">
                <option value="true" <%= suitpayConfig.isMock ? 'selected' : '' %>>Mock (simulação local, sem chaves)</option>
                <option value="false" <%= !suitpayConfig.isMock ? 'selected' : '' %>>Real (SuitPay sandbox / produção)</option>
              </select>
              <small class="field-hint">No modo real as chamadas HTTP vão para a SuitPay.</small>
            </div>

            <div class="form-group">
              <label for="suitpayClientId">SUITPAY_CLIENT_ID <span class="text-muted">(header <code>ci</code>)</span></label>
              <input type="text" id="suitpayClientId" value="<%= suitpayConfig.clientId %>" placeholder="seu_client_id_suitpay" class="admin-input" autocomplete="off" />
            </div>

            <div class="form-group">
              <label for="suitpayClientSecret">SUITPAY_CLIENT_SECRET <span class="text-muted">(header <code>cs</code>)</span></label>
              <input type="password" id="suitpayClientSecret" value="<%= suitpayConfig.clientSecret %>" placeholder="seu_client_secret_suitpay" class="admin-input" autocomplete="off" />
            </div>

            <div class="form-group">
              <label for="suitpayUrlBase">URL base da API</label>
              <input type="url" id="suitpayUrlBase" value="<%= suitpayConfig.urlBase %>" placeholder="https://ws.suitpay.app/api/v1/gateway" class="admin-input" />
            </div>

            <div class="form-group">
              <label for="publicWebhookUrl">URL pública do webhook (via túnel)</label>
              <input type="url" id="publicWebhookUrl" value="<%= suitpayConfig.publicWebhookUrl %>" placeholder="https://seu-subdominio.loca.lt/api/webhooks/suitpay" class="admin-input" />
              <small class="field-hint">Cadastre esta URL no painel de webhooks da SuitPay para baixar os Pix automaticamente.</small>
            </div>

            <div class="action-btn-row">
              <button type="button" class="btn-secondary" id="btnTestSuitpay">Testar conexão</button>
              <button type="submit" class="btn-primary">Salvar credenciais</button>
            </div>
          </form>

          <div id="testConnResult" class="mt-3" style="display: none;" aria-live="polite"></div>
        </section>

        <section class="admin-panel-card">
          <div class="panel-card-head">
            <h3><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>Túnel público</h3>
          </div>
          <p class="page-desc small">Para a SuitPay chamar o webhook no seu ambiente local, abra um túnel HTTPS na porta 3000.</p>

          <div class="tunnel-box">
            <h4>Opção 1 · Localtunnel <span class="text-muted">(sem cadastro)</span></h4>
            <code>npm run tunnel</code>
            <p class="mt-2">Ou manualmente: <code>npx localtunnel --port 3000</code></p>
          </div>

          <div class="tunnel-box mt-3">
            <h4>Opção 2 · Ngrok</h4>
            <p>Com o token configurado:</p>
            <code>/snap/bin/ngrok http 3000</code>
          </div>

          <h4 class="mt-4">Últimos depósitos registrados</h4>
          <div class="table-responsive mt-2">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Hora</th>
                  <th>Valor</th>
                  <th>Status</th>
                  <th>Referência</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentWebhooks.length > 0) { %>
                  <% recentWebhooks.forEach(w => { %>
                    <tr>
                      <td data-label="Hora"><%= new Date(w.created_at).toLocaleTimeString('pt-BR') %></td>
                      <td data-label="Valor">R$ <%= (w.amount_cents / 100).toFixed(2) %></td>
                      <td data-label="Status"><span class="<%= w.status === 'COMPLETED' ? 'badge-success' : 'badge-warning' %>"><%= w.status %></span></td>
                      <td data-label="Referência"><code><%= w.external_reference || w.id.substring(0, 8) + '...' %></code></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="4" class="empty-cell">Nenhum webhook recebido ainda.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script src="/js/admin.js"></script>
  <script>
    document.getElementById('suitpayForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        isMock: document.getElementById('suitpayMockMode').value === 'true',
        clientId: document.getElementById('suitpayClientId').value,
        clientSecret: document.getElementById('suitpayClientSecret').value,
        urlBase: document.getElementById('suitpayUrlBase').value,
        publicWebhookUrl: document.getElementById('publicWebhookUrl').value
      };

      try {
        const res = await fetch('/admin/api/suitpay/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          adminToast('Configurações da SuitPay salvas!', 'success');
          reloadSoon();
        } else {
          adminToast(data.error || 'Erro ao salvar.', 'error');
        }
      } catch (err) {
        adminToast('Erro ao salvar: ' + err.message, 'error');
      }
    });

    // Resultado do teste montado com textContent (mensagem vem de serviço externo)
    function showResult(ok, text) {
      const box = document.getElementById('testConnResult');
      box.style.display = 'block';
      box.replaceChildren();
      const div = document.createElement('div');
      div.className = ok ? 'alert-success' : 'alert-error';
      div.textContent = text;
      box.append(div);
    }

    const testBtn = document.getElementById('btnTestSuitpay');
    testBtn.addEventListener('click', async () => {
      testBtn.disabled = true;
      testBtn.textContent = 'Testando...';
      try {
        const res = await fetch('/admin/api/suitpay/test', { method: 'POST' });
        const data = await res.json();
        showResult(data.success, data.success ? `${data.mode}: ${data.message}` : `Falha no teste: ${data.message}`);
      } catch (err) {
        showResult(false, 'Erro: ' + err.message);
      } finally {
        testBtn.disabled = false;
        testBtn.textContent = 'Testar conexão';
      }
    });
  </script>
</body>
</html>
