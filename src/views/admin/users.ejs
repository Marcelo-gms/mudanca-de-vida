<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0e0507">
  <title>Tigrinho Admin | Usuários</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bungee&family=Orbitron:wght@600;800&family=Montserrat:wght@500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <div class="admin-wrapper">
    <%- include('header') %>

    <main class="admin-content">
      <header class="page-head">
        <div>
          <p class="page-kicker">Usuários</p>
          <h1>Jogadores e carteiras</h1>
          <p class="page-desc">Consulte saldos, acompanhe o rollover e faça ajustes manuais de crédito.</p>
        </div>
      </header>

      <section class="admin-panel-card mb-3">
        <form method="GET" action="/admin/users" class="search-form" role="search">
          <label class="search-field">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="search" name="q" placeholder="Buscar por nome, e-mail ou CPF" value="<%= search %>" class="admin-input search-input" aria-label="Buscar usuários" />
          </label>
          <button type="submit" class="btn-primary">Filtrar</button>
          <% if (search) { %>
            <a href="/admin/users" class="btn-ghost">Limpar</a>
          <% } %>
        </form>
      </section>

      <section class="admin-panel-card">
        <div class="table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Usuário</th>
                <th>CPF</th>
                <th>Saldo</th>
                <th>Depositado</th>
                <th>Apostado</th>
                <th>Rollover</th>
                <th>Papel</th>
                <th>Status</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% if (data.users.length > 0) { %>
                <% data.users.forEach(u => { %>
                  <tr>
                    <td data-label="Usuário"><span class="user-cell"><strong><%= u.name %></strong><small class="text-muted"><%= u.email %></small></span></td>
                    <td data-label="CPF"><code><%= u.document %></code></td>
                    <td data-label="Saldo"><strong class="color-gold">R$ <%= u.balanceFormatted %></strong></td>
                    <td data-label="Depositado">R$ <%= u.depositedFormatted %></td>
                    <td data-label="Apostado">R$ <%= u.wageredFormatted %></td>
                    <td data-label="Rollover">
                      <% if (u.rolloverMet) { %>
                        <span class="badge-success">Cumprido</span>
                      <% } else { %>
                        <span class="rollover-cell">
                          <span class="badge-warning"><%= u.rolloverProgress %>%</span>
                          <small class="text-muted">Meta R$ <%= u.rolloverRequiredFormatted %></small>
                        </span>
                      <% } %>
                    </td>
                    <td data-label="Papel">
                      <span class="<%= u.role === 'admin' ? 'badge-admin' : 'badge-user' %>"><%= u.role === 'admin' ? 'Admin' : 'Jogador' %></span>
                    </td>
                    <td data-label="Status">
                      <span class="<%= u.status === 'active' ? 'badge-success' : 'badge-danger' %>"><%= u.status === 'active' ? 'Ativo' : 'Bloqueado' %></span>
                    </td>
                    <td data-label="Ações" class="cell-actions">
                      <div class="action-btn-group" data-id="<%= u.id %>" data-name="<%= u.name %>" data-balance="<%= u.balanceFormatted %>">
                        <button type="button" class="btn-action" data-action="adjust">Saldo</button>
                        <button type="button" class="btn-action" data-action="rollover">Liberar rollover</button>
                        <button type="button" class="btn-action <%= u.status === 'active' ? 'danger' : '' %>" data-action="status"><%= u.status === 'active' ? 'Bloquear' : 'Ativar' %></button>
                        <button type="button" class="btn-action" data-action="role"><%= u.role === 'admin' ? 'Tornar jogador' : 'Tornar admin' %></button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="9" class="empty-cell">Nenhum usuário encontrado.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <!-- Modal Ajuste de Saldo -->
  <div class="modal-overlay" id="adjustBalanceModal">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="adjustTitle">
      <div class="modal-header">
        <h3 id="adjustTitle">Ajuste manual de saldo</h3>
        <button class="modal-close" type="button" data-close-modal aria-label="Fechar">✕</button>
      </div>
      <div class="modal-body">
        <p class="modal-desc">Créditos de <strong id="adjustUserName"></strong> · saldo atual R$ <span id="adjustUserBal"></span></p>

        <div class="form-group">
          <label for="adjustAmountInput">Valor do ajuste (R$)</label>
          <input type="number" id="adjustAmountInput" step="0.50" placeholder="Ex.: 50 para somar, -20 para subtrair" class="admin-input" inputmode="decimal">
          <small class="field-hint">Positivo credita, negativo debita.</small>
        </div>

        <div class="form-group">
          <label for="adjustReasonInput">Motivo</label>
          <input type="text" id="adjustReasonInput" value="Ajuste manual pela administração" class="admin-input">
        </div>

        <button class="btn-primary btn-block" type="button" id="confirmAdjustBtn">Confirmar ajuste</button>
      </div>
    </div>
  </div>

  <script src="/js/admin.js"></script>
  <script>
    const modal = document.getElementById('adjustBalanceModal');
    let currentAdjustUserId = null;

    async function post(url, body) {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      return res.json();
    }

    // Ações lidas de data-* (nada de JS inline com dados do usuário)
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-action]');
      if (!btn) return;
      const { id, name, balance } = btn.closest('.action-btn-group').dataset;

      try {
        if (btn.dataset.action === 'adjust') {
          currentAdjustUserId = id;
          document.getElementById('adjustUserName').textContent = name;
          document.getElementById('adjustUserBal').textContent = balance;
          document.getElementById('adjustAmountInput').value = '';
          modal.classList.add('active');
          document.getElementById('adjustAmountInput').focus();
          return;
        }

        if (btn.dataset.action === 'rollover') {
          if (!confirm(`Liberar 100% do rollover de ${name}?`)) return;
          const data = await post('/admin/api/users/reset-rollover', { userId: id });
          if (!data.success) return adminToast(data.error || 'Erro ao liberar rollover.', 'error');
          adminToast('Rollover liberado!', 'success');
          return reloadSoon();
        }

        if (btn.dataset.action === 'status') {
          const data = await post('/admin/api/users/toggle-status', { userId: id });
          if (!data.success) return adminToast(data.error || 'Erro ao alterar status.', 'error');
          return location.reload();
        }

        if (btn.dataset.action === 'role') {
          if (!confirm(`Alternar a permissão de ${name} entre Jogador e Admin?`)) return;
          const data = await post('/admin/api/users/toggle-role', { userId: id });
          if (!data.success) return adminToast(data.error || 'Erro ao alterar papel.', 'error');
          return location.reload();
        }
      } catch (err) {
        adminToast('Erro: ' + err.message, 'error');
      }
    });

    document.querySelector('[data-close-modal]').addEventListener('click', () => modal.classList.remove('active'));

    document.getElementById('confirmAdjustBtn').addEventListener('click', async () => {
      const amount = parseFloat(document.getElementById('adjustAmountInput').value);
      const reason = document.getElementById('adjustReasonInput').value;
      if (isNaN(amount) || amount === 0) return adminToast('Informe um valor válido.', 'error');

      try {
        const data = await post('/admin/api/users/adjust-balance', { userId: currentAdjustUserId, deltaAmount: amount, reason });
        if (!data.success) return adminToast(data.error || 'Erro ao ajustar saldo.', 'error');
        modal.classList.remove('active');
        adminToast('Saldo ajustado! Novo saldo: R$ ' + data.newBalanceFormatted, 'success');
        reloadSoon();
      } catch (err) {
        adminToast('Erro: ' + err.message, 'error');
      }
    });
  </script>
</body>
</html>
