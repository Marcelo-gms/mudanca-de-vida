<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tigrinho Admin | Calibração de RTP e House Edge</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="admin-body">
  <div class="admin-wrapper">
    <%- include('header') %>

    <main class="admin-content">
      <div class="page-title-row">
        <div>
          <h2>Calibração Matemática: RTP, House Edge e Volatilidade</h2>
          <p>Ajuste dinamicamente a margem de retenção da casa, a probabilidade do bônus e teste o impacto em tempo real.</p>
        </div>
      </div>

      <div class="admin-grid-2">
        <!-- Painel de Configurações -->
        <div class="admin-panel-card">
          <div class="panel-card-head">
            <h3>⚙️ Parâmetros do Motor Matemático</h3>
          </div>

          <form id="rtpSettingsForm" class="mt-3">
            <!-- RTP Target Slider -->
            <div class="form-group">
              <div class="flex-between">
                <label>RTP Teórico Alvo (%):</label>
                <strong id="rtpValDisplay" class="color-gold"><%= mathConfig.rtpTarget %>%</strong>
              </div>
              <input
                type="range"
                id="rtpTargetInput"
                min="80"
                max="105"
                step="0.5"
                value="<%= mathConfig.rtpTarget %>"
                class="admin-slider"
              />
              <small class="field-hint">Percentual médio retornado aos jogadores ao longo do tempo.</small>
            </div>

            <!-- House Edge Readout -->
            <div class="form-group">
              <div class="flex-between">
                <label>House Edge Estimado (Margem da Casa):</label>
                <strong id="houseEdgeValDisplay" class="color-green"><%= mathConfig.houseEdge %>%</strong>
              </div>
              <small class="field-hint">Cálculo direto: <code>100% - RTP</code></small>
            </div>

            <!-- Tigre da Sorte Bonus Chance -->
            <div class="form-group">
              <div class="flex-between">
                <label>Frequência do Bônus "Tigre da Sorte" (%):</label>
                <strong id="bonusValDisplay" class="color-gold"><%= mathConfig.bonusChance %>%</strong>
              </div>
              <input
                type="range"
                id="bonusChanceInput"
                min="0"
                max="10"
                step="0.5"
                value="<%= mathConfig.bonusChance %>"
                class="admin-slider"
              />
              <small class="field-hint">Controla a taxa de ativação da rodada especial de 5x (3% = padrão 96% RTP).</small>
            </div>

            <!-- Rollover Factor -->
            <div class="form-group">
              <label>Fator de Rollover Obrigatório para Saque (x):</label>
              <input
                type="number"
                id="rolloverFactorInput"
                min="0.5"
                max="10"
                step="0.5"
                value="<%= rolloverFactor %>"
                class="admin-input"
              />
              <small class="field-hint">Ex: 1.0x exige apostar 100% do valor depositado antes de liberar saques.</small>
            </div>

            <!-- Symbol Weights -->
            <div class="form-group mt-3">
              <label>Tabela de Pesos dos Rolos (PAR Sheet):</label>
              <div class="weights-grid">
                <div class="weight-item">
                  <span>🐯 Tigre (Wild 50x):</span>
                  <input type="number" id="weightTigre" value="<%= mathConfig.symbolWeights.TIGRE %>" min="1" max="50" class="admin-input">
                </div>
                <div class="weight-item">
                  <span>💰 Moeda (10x):</span>
                  <input type="number" id="weightMoeda" value="<%= mathConfig.symbolWeights.MOEDA %>" min="1" max="50" class="admin-input">
                </div>
                <div class="weight-item">
                  <span>🧧 Barra (5x):</span>
                  <input type="number" id="weightBarra" value="<%= mathConfig.symbolWeights.BARRA %>" min="1" max="80" class="admin-input">
                </div>
                <div class="weight-item">
                  <span>🍊 Laranja (2x):</span>
                  <input type="number" id="weightLaranja" value="<%= mathConfig.symbolWeights.LARANJA %>" min="10" max="150" class="admin-input">
                </div>
              </div>
            </div>

            <div class="action-btn-row mt-4">
              <button type="button" class="btn-secondary" id="btnTestSimulation">
                🧪 Testar Simulação (10.000 Giros)
              </button>
              <button type="submit" class="btn-primary" id="btnSaveRtp">
                💾 Salvar e Aplicar
              </button>
            </div>
          </form>
        </div>

        <!-- Painel de Resultados do Simulador -->
        <div class="admin-panel-card">
          <div class="panel-card-head">
            <h3>📊 Simulador Monte Carlo em Tempo Real</h3>
          </div>
          <p class="modal-desc">Execute testes instantâneos para auditar a matemática antes de aplicar aos jogadores reais.</p>

          <div id="simEmptyNotice" class="sim-empty-box">
            Clique em <strong>"Testar Simulação"</strong> para rodar 10.000 rodadas com os parâmetros selecionados.
          </div>

          <div id="simResultsBox" style="display: none;">
            <div class="kpi-grid-mini">
              <div class="kpi-card-mini">
                <span class="mini-title">RTP Medido</span>
                <span class="mini-val" id="simRtpVal">0%</span>
              </div>
              <div class="kpi-card-mini">
                <span class="mini-title">House Edge Medido</span>
                <span class="mini-val" id="simHouseEdgeVal">0%</span>
              </div>
              <div class="kpi-card-mini">
                <span class="mini-title">Hit Frequency</span>
                <span class="mini-val" id="simHitFreqVal">0%</span>
              </div>
              <div class="kpi-card-mini">
                <span class="mini-title">Tempo de Teste</span>
                <span class="mini-val" id="simTimeVal">0ms</span>
              </div>
            </div>

            <div class="mt-3">
              <h4>Distribuição de Linhas Premiadas:</h4>
              <ul class="sim-hits-list">
                <li><span>🐯 Tigres (50x):</span> <strong id="simHitTigre">0</strong></li>
                <li><span>💰 Moedas (10x):</span> <strong id="simHitMoeda">0</strong></li>
                <li><span>🧧 Barras (5x):</span> <strong id="simHitBarra">0</strong></li>
                <li><span>🍊 Laranjas (2x):</span> <strong id="simHitLaranja">0</strong></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const rtpInput = document.getElementById('rtpTargetInput');
    const rtpDisplay = document.getElementById('rtpValDisplay');
    const houseEdgeDisplay = document.getElementById('houseEdgeValDisplay');
    const bonusInput = document.getElementById('bonusChanceInput');
    const bonusDisplay = document.getElementById('bonusValDisplay');

    rtpInput.addEventListener('input', (e) => {
      const val = parseFloat(e.target.value);
      rtpDisplay.textContent = val.toFixed(1) + '%';
      houseEdgeDisplay.textContent = (100 - val).toFixed(1) + '%';
    });

    bonusInput.addEventListener('input', (e) => {
      bonusDisplay.textContent = parseFloat(e.target.value).toFixed(1) + '%';
    });

    function getFormPayload() {
      return {
        rtpTarget: parseFloat(rtpInput.value),
        bonusChance: parseFloat(bonusInput.value),
        rolloverFactor: parseFloat(document.getElementById('rolloverFactorInput').value),
        symbolWeights: {
          TIGRE: parseInt(document.getElementById('weightTigre').value, 10),
          MOEDA: parseInt(document.getElementById('weightMoeda').value, 10),
          BARRA: parseInt(document.getElementById('weightBarra').value, 10),
          LARANJA: parseInt(document.getElementById('weightLaranja').value, 10)
        }
      };
    }

    // Teste de Simulação
    document.getElementById('btnTestSimulation').addEventListener('click', async () => {
      const btn = document.getElementById('btnTestSimulation');
      btn.disabled = true;
      btn.textContent = 'Simulando...';

      const payload = getFormPayload();

      try {
        const res = await fetch('/admin/api/rtp/simulate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            spins: 10000,
            bonusChance: payload.bonusChance,
            symbolWeights: payload.symbolWeights
          })
        });

        const data = await res.json();
        if (data.success && data.simulation) {
          const sim = data.simulation;
          document.getElementById('simEmptyNotice').style.display = 'none';
          document.getElementById('simResultsBox').style.display = 'block';

          document.getElementById('simRtpVal').textContent = sim.rtp + '%';
          document.getElementById('simHouseEdgeVal').textContent = sim.houseEdge + '%';
          document.getElementById('simHitFreqVal').textContent = sim.hitFrequency + '%';
          document.getElementById('simTimeVal').textContent = sim.elapsedMs + 'ms';

          document.getElementById('simHitTigre').textContent = sim.hitsBySymbol.TIGRE.toLocaleString();
          document.getElementById('simHitMoeda').textContent = sim.hitsBySymbol.MOEDA.toLocaleString();
          document.getElementById('simHitBarra').textContent = sim.hitsBySymbol.BARRA.toLocaleString();
          document.getElementById('simHitLaranja').textContent = sim.hitsBySymbol.LARANJA.toLocaleString();
        }
      } catch (err) {
        alert('Erro ao simular: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.textContent = '🧪 Testar Simulação (10.000 Giros)';
      }
    });

    // Salvar Configurações
    document.getElementById('rtpSettingsForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = getFormPayload();

      try {
        const res = await fetch('/admin/api/rtp/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (data.success) {
          alert('✅ Configurações matemáticas atualizadas com sucesso!');
        } else {
          alert(data.error);
        }
      } catch (err) {
        alert('Erro ao salvar: ' + err.message);
      }
    });
  </script>
</body>
</html>

